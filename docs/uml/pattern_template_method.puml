interface ReportsSource {
  +today(timezone): date
  +title_activity(period)
  +registrations(period)
  +activity_by_bucket(period)
  +revenue_by_bucket(period)
  +payment_status_counts(period)
  +active_premium(): int
}

class ReportRepository
class SettingsService {
  +report_timezone(): str
}
class Report <<dataclass>> {
  kind, title, date_from, date_to
  group_by, timezone
  summary: tuple[SummaryItem]
  sections: tuple[ReportSection]
}
class CsvReportExporter {
  +export(report): bytes
  +filename(report): str
}

ReportService o--> "3" ReportGenerator
ReportService --> SettingsService : ReportSettingsProvider
PopularTitlesReport -up-|> ReportGenerator
UserActivityReport -up-|> ReportGenerator
SubscriptionRevenueReport -up-|> ReportGenerator
PopularTitlesReport --> ReportsSource : PopularTitlesSource
UserActivityReport --> ReportsSource : UserActivitySource
SubscriptionRevenueReport --> ReportsSource : RevenueSource
ReportRepository .up.|> ReportsSource
ReportGenerator ..> Report : <<create>>
CsvReportExporter ..> Report

note right of ReportGenerator
  <b>Яку проблему вирішує.</b>
  Три звіти мають однаковий порядок кроків: перевірити період
  у часовому поясі з налаштувань → зібрати рядки з БД →
  агрегувати → підсумок → секції таблиць. generate() фіксує
  цей порядок (~__init_subclass~__ забороняє його перевизначати),
  підкласи змінюють лише кроки й гачки, а результат
  однаково віддається в JSON і CSV.
end note
@enduml
