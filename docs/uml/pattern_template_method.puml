@startuml pattern_template_method
!include _style.iuml
set separator none
hide empty members
skinparam nodesep 35
skinparam ranksep 55

title Template Method — звіти (services/reports.py)

class ReportService <<Client>> {
  generators: dict[str, ReportGenerator]
  settings: ReportSettingsProvider
  +kinds(): tuple[str, ...]
  +generate(kind, params): Report
}

abstract class "ReportGenerator[RowsT, DataT]" as ReportGenerator <<AbstractClass>> $TEMPLATE {
  kind: ClassVar[str]
  title: ClassVar[str]
  MAX_PERIOD_DAYS = 3660
  .. шаблонний метод ..
  +generate(params): Report {final}
  .. кроки ..
  #validate(params): Period
  #{abstract} collect(period): RowsT
  #{abstract} aggregate(rows, period): DataT
  #{abstract} summarize(data, period): tuple[SummaryItem]
  #{abstract} sections(data, period): tuple[ReportSection]
  #build(data, summary, period): Report
  .. гачки (hooks) ..
  #default_period(today): (date, date)
  #default_group_by(): GroupBy
  #extra_validation(period)
}

