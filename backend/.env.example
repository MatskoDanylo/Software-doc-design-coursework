# Development defaults. Copy to .env and change SECRET_KEY / ADMIN_PASSWORD outside local dev.
DATABASE_URL=postgresql+psycopg://cinema:cinema@localhost:5432/cinema
SECRET_KEY=dev-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MEDIA_DIR=../media
PREMIUM_DAYS=30
# Enables POST /api/billing/payments/{id}/mock-result for the dev payment page.
PAYMENTS_MOCK_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SEC=3600
MAX_VIDEO_UPLOAD_MB=2048
# Font for demo video captions; auto-detected (Arial / DejaVu Sans) when empty.
# DEMO_FONT_FILE=C:/Windows/Fonts/arial.ttf
# Used by pytest instead of DATABASE_URL; the database name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://cinema:cinema@localhost:5432/cinema_test
